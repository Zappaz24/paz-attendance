# Copy to .env.local and fill in. Never commit .env.local.
#
# Option A — local Supabase in Docker (values from `npx supabase status`):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Option B — hosted project (Dashboard -> Project Settings -> API Keys):
#   * URL = project URL only, WITHOUT /rest/v1 on the end
#   * NEXT_PUBLIC_SUPABASE_ANON_KEY = publishable key (or legacy anon JWT)
#   * SUPABASE_SERVICE_ROLE_KEY     = SECRET key (sb_secret_... / legacy service_role)
#   e.g.
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
#   SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
#
# See docs/cloud-supabase.md for the three mistakes to avoid.
